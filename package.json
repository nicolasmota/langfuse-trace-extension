{
  "name": "langfuse-traces",
  "publisher": "nicolasmota",
  "displayName": "Langfuse Traces",
  "description": "Inline Langfuse trace viewer for VS Code — inspect LLM spans, token usage and costs without leaving the editor",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasmota/langfuse-trace-extension.git"
  },
  "homepage": "https://github.com/nicolasmota/langfuse-trace-extension",
  "bugs": {
    "url": "https://github.com/nicolasmota/langfuse-trace-extension/issues"
  },
  "engines": {
    "vscode": "^1.96.2"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "langfuse",
    "llm",
    "observability",
    "tracing",
    "ai"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "langfuse",
          "title": "Langfuse",
          "icon": "images/icon-activity-bar.svg"
        }
      ]
    },
    "views": {
      "langfuse": [
        {
          "id": "langfuse.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "langfuse.sessions",
        "contents": "Recent Langfuse sessions load automatically.\n[Refresh](command:langfuse.sessions.refresh)\n[Open by ID…](command:langfuse.openTraceById)"
      }
    ],
    "commands": [
      {
        "command": "langfuse.openTrace",
        "title": "Open Trace Panel",
        "category": "Langfuse"
      },
      {
        "command": "langfuse.openTraceById",
        "title": "Open Trace by Session ID…",
        "category": "Langfuse"
      },
      {
        "command": "langfuse.exportContext",
        "title": "Send Trace Context to Chat",
        "category": "Langfuse"
      },
      {
        "command": "langfuse.sessions.add",
        "title": "Add Session",
        "category": "Langfuse",
        "icon": "$(add)"
      },
      {
        "command": "langfuse.sessions.refresh",
        "title": "Refresh",
        "category": "Langfuse",
        "icon": "$(refresh)"
      },
      {
        "command": "langfuse.sessions.open",
        "title": "Open Session Traces",
        "category": "Langfuse"
      },
      {
        "command": "langfuse.sessions.remove",
        "title": "Hide from Sidebar",
        "category": "Langfuse"
      },
      {
        "command": "langfuse.sessions.sendToChat",
        "title": "Send Session to Chat (MCP)",
        "category": "Langfuse"
      },
      {
        "command": "langfuse.mcp.reregister",
        "title": "Register MCP Server",
        "category": "Langfuse"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "langfuse.sessions.add",
          "when": "view == langfuse.sessions",
          "group": "navigation@1"
        },
        {
          "command": "langfuse.sessions.refresh",
          "when": "view == langfuse.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "langfuse.sessions.open",
          "when": "view == langfuse.sessions && viewItem == langfuseSession",
          "group": "inline@1"
        },
        {
          "command": "langfuse.sessions.remove",
          "when": "view == langfuse.sessions && viewItem == langfuseSession",
          "group": "inline@2"
        },
        {
          "command": "langfuse.sessions.sendToChat",
          "when": "view == langfuse.sessions && viewItem == langfuseSession",
          "group": "1_modification@1"
        }
      ]
    },
    "configuration": {
      "title": "Langfuse Traces",
      "properties": {
        "langfuse.host": {
          "type": "string",
          "default": "http://127.0.0.1:3000",
          "description": "Base URL of the Langfuse instance (cloud or self-hosted). Uses 127.0.0.1 for local Docker to avoid IPv6 resolution issues."
        },
        "langfuse.publicKey": {
          "type": "string",
          "default": "pk-lf-local-dev",
          "description": "Langfuse public key for API authentication."
        },
        "langfuse.secretKey": {
          "type": "string",
          "default": "sk-lf-local-dev",
          "description": "Langfuse secret key for API authentication."
        },
        "langfuse.recentSessionsLimit": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "How many recent Langfuse sessions to show in the sidebar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.96.2",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
